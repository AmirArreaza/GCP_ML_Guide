        <!-- ===== CORE CONCEPTS BOX ===== -->
        <mxCell id="concepts" value="&lt;b&gt;Core Concepts&lt;/b&gt;&lt;br&gt;Data Store = indexed knowledge&lt;br&gt;App = serving layer + config&lt;br&gt;Blended = 1 app + many stores&lt;br&gt;Grounding = LLM anchored to sources&lt;br&gt;Summary = AI-generated answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#1a237e;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="580" width="310" height="110" as="geometry" />
        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- Data store ≠ app — they are separate resources&lt;br&gt;- Blended search = 1 app, multiple data stores&lt;br&gt;- SEARCH_ADD_ON_LLM required for SummarySpec&lt;br&gt;- SummarySpec=AI answer / Snippet=extract / Extractive=verbatim&lt;br&gt;- Boost: -1 (bury) to +1 (promote)&lt;br&gt;- Private grounding: Tool.from_retrieval(VertexAISearch)&lt;br&gt;- Public grounding: Tool.from_google_search_retrieval()&lt;br&gt;- answer_query() = conversational multi-turn with session&lt;br&gt;- INCREMENTAL = add docs / FULL = replace all&lt;br&gt;- 3rd-party connectors = no custom ETL needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1520" width="340" height="195" as="geometry" />
        </mxCell>

