        <mxCell id="b7-4" value="ADK: VertexAiSearchRetrieval tool&lt;br&gt;&lt;i&gt;search tool for ADK agents&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
