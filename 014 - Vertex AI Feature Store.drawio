        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- V2 uses BigQuery as offline store — no separate store&lt;br&gt;- FeatureOnlineStore → FeatureView (mandatory for serving)&lt;br&gt;- FeatureGroup → Feature (optional — for registry/monitoring)&lt;br&gt;- Bigtable = active; Optimized = deprecated (Feb 2027)&lt;br&gt;- Continuous sync: Bigtable + FeatureGroups + eu/us regions&lt;br&gt;- Continuous sync: new inserts only — no updates/deletes&lt;br&gt;- feature_timestamp prevents training label leakage&lt;br&gt;- Training-serving skew: prevented by single BQ source&lt;br&gt;- Feature monitoring requires FeatureGroup registration&lt;br&gt;- V1 used EntityType hierarchy — deprecated, not V2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1530" width="350" height="215" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
