        <!-- ===== CENTRAL NODE ===== -->
        <mxCell id="center" value="&lt;b&gt;Gemini File API&lt;/b&gt;&lt;br&gt;&lt;i&gt;Multimodal File Handling&lt;/i&gt;&lt;br&gt;Images · Video · Audio · Docs" style="ellipse;whiteSpace=wrap;html=1;fillColor=#37474f;fontColor=#ffffff;strokeColor=#1c313a;fontSize=14;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="710" width="310" height="115" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 1: THREE INPUT METHODS (top-centre) ===== -->
        <mxCell id="b1" value="&lt;b&gt;3 Input Methods&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;strokeColor=#0d47a1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="405" width="310" height="52" as="geometry" />
