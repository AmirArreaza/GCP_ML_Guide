  <diagram name="Gemini File API" id="gemini-file-api">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2700" pageHeight="1900" math="0" shadow="1">
      <root>
        <mxCell id="0" />
