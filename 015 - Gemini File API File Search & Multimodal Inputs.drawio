          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-1" value="Files API Upload&lt;br&gt;&lt;i&gt;2 GB max · 48-hr TTL · reusable&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="675" y="195" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;" edge="1" source="b1" target="b1-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-2" value="Inline Data (base64)&lt;br&gt;&lt;i&gt;~100 MB max · no storage · quick use&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="910" y="195" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;" edge="1" source="b1" target="b1-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-3" value="GCS URI / External HTTPS URL&lt;br&gt;&lt;i&gt;persistent · no upload needed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1145" y="195" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c62828;strokeWidth=2;" edge="1" source="b1" target="b1-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-note" value="GCS URIs: Vertex AI only (gs://...)&lt;br&gt;&lt;i&gt;HTTPS URLs: both Vertex AI &amp; Developer API&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1380" y="195" width="230" height="60" as="geometry" />
