          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 2: FILES API WORKFLOW (left-top) ===== -->
        <mxCell id="b2" value="&lt;b&gt;Files API Workflow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;fontColor=#ffffff;strokeColor=#1b5e20;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="440" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="center" target="b2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-1" value="client.files.upload(file=...)&lt;br&gt;&lt;i&gt;returns file.uri + file.name&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="285" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;" edge="1" source="b2" target="b2-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-2" value="Check state: PROCESSING → ACTIVE&lt;br&gt;&lt;i&gt;poll client.files.get() before use&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="353" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;" edge="1" source="b2" target="b2-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-3" value="Use file.uri in generate_content()&lt;br&gt;&lt;i&gt;file_data: {file_uri, mime_type}&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="421" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;" edge="1" source="b2" target="b2-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-4" value="client.files.list()&lt;br&gt;&lt;i&gt;view all uploaded files&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="489" width="215" height="52" as="geometry" />
