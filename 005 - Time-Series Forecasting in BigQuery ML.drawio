        </mxCell>

        <mxCell id="b2-2" value="2. ML.EVALUATE&lt;br&gt;&lt;i&gt;no input table needed!&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
