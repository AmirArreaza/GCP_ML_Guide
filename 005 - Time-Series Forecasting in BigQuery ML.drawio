        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- Use ML.FORECAST not ML.PREDICT&lt;br&gt;- ML.EVALUATE needs no input table&lt;br&gt;- Timestamp col must be DATE/DATETIME/TIMESTAMP&lt;br&gt;- XREG needs future regressor values for forecast&lt;br&gt;- MAPE is scale-independent — best for multi-series compare&lt;br&gt;- AIC used by auto-ARIMA to pick best (p,d,q)&lt;br&gt;- holiday_region needs decompose_time_series=TRUE&lt;br&gt;- time_series_id_col trains N independent models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="1120" width="310" height="155" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
