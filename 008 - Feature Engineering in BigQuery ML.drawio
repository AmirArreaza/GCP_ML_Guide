        <mxCell id="e-b7-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-3" value="ML.IMPUTER(col, 'most_frequent')&lt;br&gt;&lt;i&gt;categorical or highly skewed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="882" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 8: WHEN TO SCALE (bottom-centre) ===== -->
        <mxCell id="b8" value="&lt;b&gt;When to Scale&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f57f17;fontColor=#ffffff;strokeColor=#e65100;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="1020" width="280" height="52" as="geometry" />
