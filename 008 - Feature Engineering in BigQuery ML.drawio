        <mxCell id="b1-1" value="Stored WITH the model&lt;br&gt;&lt;i&gt;part of model definition&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
