          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-1" value="ML.IMPUTER(col, 'mean')&lt;br&gt;&lt;i&gt;numeric, normally distributed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="746" width="215" height="52" as="geometry" />
