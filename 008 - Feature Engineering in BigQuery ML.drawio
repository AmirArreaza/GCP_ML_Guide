        </mxCell>

        <mxCell id="b3-1" value="ML.BUCKETIZE&lt;br&gt;&lt;i&gt;manual fixed boundaries&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;" vertex="1" parent="1">
