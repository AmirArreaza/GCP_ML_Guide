        </mxCell>

        <mxCell id="b5-2" value="countryxdevice = US_mobile&lt;br&gt;&lt;i&gt;captures interaction effects&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
