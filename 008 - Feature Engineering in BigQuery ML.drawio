          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-2" value="ML.IMPUTER(col, 'median')&lt;br&gt;&lt;i&gt;numeric, skewed / outliers&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="814" width="215" height="52" as="geometry" />
