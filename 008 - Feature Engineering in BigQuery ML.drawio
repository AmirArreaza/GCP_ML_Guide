          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b8-1" value="Linear reg / logistic reg&lt;br&gt;&lt;i&gt;MUST scale — gradient descent&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="1150" width="210" height="52" as="geometry" />
