          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b5-3" value="ML.POLYNOMIAL_EXPAND&lt;br&gt;&lt;i&gt;adds non-linear terms to linear models&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="466" width="215" height="52" as="geometry" />
