          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b4-1" value="ML.ONE_HOT_ENCODER&lt;br&gt;&lt;i&gt;binary per category — NOMINAL&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=11;fontStyle=1;" vertex="1" parent="1">
