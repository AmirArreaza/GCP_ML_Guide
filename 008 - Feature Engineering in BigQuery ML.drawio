        <mxCell id="b5-1" value="ML.FEATURE_CROSS&lt;br&gt;&lt;i&gt;Cartesian product of categoricals&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
