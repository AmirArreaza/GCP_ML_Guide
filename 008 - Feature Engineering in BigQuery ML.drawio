          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-4" value="Pass label col through unchanged&lt;br&gt;&lt;i&gt;include label_col in TRANSFORM&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1310" y="190" width="210" height="50" as="geometry" />
