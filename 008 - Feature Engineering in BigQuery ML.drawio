          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-1" value="ML.STANDARD_SCALER&lt;br&gt;&lt;i&gt;(x-mean)/std → default choice&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1b5e20;" edge="1" source="b2" target="b2-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-2" value="ML.MIN_MAX_SCALER&lt;br&gt;&lt;i&gt;(x-min)/(max-min) → [0,1] range&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="338" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1b5e20;" edge="1" source="b2" target="b2-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-3" value="ML.MAX_ABS_SCALER&lt;br&gt;&lt;i&gt;x/max_abs → [-1,1] sparse-safe&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="406" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1b5e20;" edge="1" source="b2" target="b2-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-4" value="ML.ROBUST_SCALER&lt;br&gt;&lt;i&gt;(x-median)/IQR → outlier-robust&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="474" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1b5e20;strokeWidth=2;" edge="1" source="b2" target="b2-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 3: BINNING (bottom-left) ===== -->
        <mxCell id="b3" value="&lt;b&gt;Binning&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e65100;fontColor=#ffffff;strokeColor=#bf360c;fontSize=13;fontStyle=1;" vertex="1" parent="1">
