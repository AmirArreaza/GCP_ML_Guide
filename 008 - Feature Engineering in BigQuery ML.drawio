        <mxCell id="e-b3-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#e65100;" edge="1" source="b3" target="b3-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3-key" value="BUCKETIZE = you know the splits&lt;br&gt;QUANTILE = data drives the splits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="215" height="50" as="geometry" />
