        </mxCell>

        <mxCell id="b5-4" value="degree 2: f1, f2, f1^2, f1xf2, f2^2&lt;br&gt;&lt;i&gt;increases expressiveness&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
