          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== SCALER DECISION BOX ===== -->
        <mxCell id="scalerchoice" value="&lt;b&gt;Scaler Decision Guide&lt;/b&gt;&lt;br&gt;Data normally distributed → STANDARD&lt;br&gt;Need [0,1] range → MIN_MAX&lt;br&gt;Sparse / centred data → MAX_ABS&lt;br&gt;Significant outliers → ROBUST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#1b5e20;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- ===== ENCODER DECISION BOX ===== -->
        <mxCell id="encoderchoice" value="&lt;b&gt;Encoder Decision Guide&lt;/b&gt;&lt;br&gt;Unordered categories → ONE_HOT&lt;br&gt;Ordered categories → LABEL&lt;br&gt;Array / multi-label → MULTI_HOT&lt;br&gt;Two cats interact → FEATURE_CROSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- TRANSFORM auto-applied at ML.PREDICT&lt;br&gt;- OVER() required on ALL preprocessing functions&lt;br&gt;- ROBUST_SCALER for outlier-heavy features&lt;br&gt;- BUCKETIZE = manual / QUANTILE = auto boundaries&lt;br&gt;- ONE_HOT = nominal / LABEL = ordinal categories&lt;br&gt;- MULTI_HOT handles ARRAY type columns&lt;br&gt;- FEATURE_CROSS captures interaction effects&lt;br&gt;- Trees = scale-invariant; linear/NN/KMeans need scaling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="1250" width="310" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
