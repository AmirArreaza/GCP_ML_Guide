          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 2: NUMERIC SCALERS (left) ===== -->
        <mxCell id="b2" value="&lt;b&gt;Numeric Scalers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b5e20;fontColor=#ffffff;strokeColor=#0a3d0a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="430" width="195" height="52" as="geometry" />
