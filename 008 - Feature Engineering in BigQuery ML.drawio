          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b8-4" value="Boosted trees / Random Forest&lt;br&gt;&lt;i&gt;scale-invariant — not needed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1150" width="210" height="52" as="geometry" />
