        <!-- ===== BRANCH 5: INTERACTION FEATURES (top-right) ===== -->
        <mxCell id="b5" value="&lt;b&gt;Interaction Features&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bf360c;fontColor=#ffffff;strokeColor=#870000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
