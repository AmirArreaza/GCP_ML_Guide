        <mxCell id="b6-1" value="ML.NGRAMS&lt;br&gt;&lt;i&gt;word or character n-grams&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
