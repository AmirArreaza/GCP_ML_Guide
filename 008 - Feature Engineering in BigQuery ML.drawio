        </mxCell>

        <!-- ===== BRANCH 7: MISSING DATA (bottom-right) ===== -->
        <mxCell id="b7" value="&lt;b&gt;Missing Data&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;fontColor=#ffffff;strokeColor=#1c313a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
