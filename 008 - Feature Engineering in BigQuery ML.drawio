          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 4: CATEGORICAL ENCODERS (top-left) ===== -->
        <mxCell id="b4" value="&lt;b&gt;Categorical Encoders&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;fontColor=#ffffff;strokeColor=#4a148c;fontSize=13;fontStyle=1;" vertex="1" parent="1">
