          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-2" value="Auto-applied at ML.PREDICT&lt;br&gt;&lt;i&gt;no manual re-transform needed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="190" width="210" height="50" as="geometry" />
