          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b6-2" value="SPLIT(text, ' ') for word n-grams&lt;br&gt;SPLIT(text, '') for char n-grams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="678" width="215" height="52" as="geometry" />
