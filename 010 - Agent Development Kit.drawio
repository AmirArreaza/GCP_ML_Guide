        <!-- ===== CORE PRIMITIVES BOX ===== -->
        <mxCell id="primitives" value="&lt;b&gt;3 Core Primitives&lt;/b&gt;&lt;br&gt;1. Agent (reasoning unit)&lt;br&gt;2. Tool (external capability)&lt;br&gt;3. Callback (lifecycle intercept)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#1a237e;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="545" width="310" height="105" as="geometry" />
        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- LlmAgent = dynamic; workflow agents = deterministic&lt;br&gt;- Docstring + type hints = auto tool schema&lt;br&gt;- Callback returning non-None = short-circuits execution&lt;br&gt;- Session state = within session; Memory Bank = cross-session&lt;br&gt;- VertexAiSessionService = managed production sessions&lt;br&gt;- AdkApp wraps agent for Vertex AI deployment&lt;br&gt;- adk web = local browser dev UI&lt;br&gt;- A2A enables cross-framework agent comms&lt;br&gt;- PreloadMemoryTool loads memory every turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1420" width="330" height="180" as="geometry" />
        </mxCell>

