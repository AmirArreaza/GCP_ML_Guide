        <mxCell id="b7-3" value="A2A Protocol&lt;br&gt;&lt;i&gt;cross-framework agent communication&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1290" width="205" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-4" value="LangChain / LangGraph / CrewAI support&lt;br&gt;&lt;i&gt;3rd-party agents usable as tools&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="1290" width="205" height="52" as="geometry" />
