        <mxCell id="b7-4" value="Gemini 3: temperature default = 1.0&lt;br&gt;&lt;i&gt;do NOT lower it — causes degradation&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1395" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c62828;strokeWidth=2;" edge="1" source="b7" target="b7-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== CORE CONCEPTS BOX ===== -->
        <mxCell id="concepts" value="&lt;b&gt;Core Concepts&lt;/b&gt;&lt;br&gt;System instruction = persistent rules across turns&lt;br&gt;Temperature 0 = greedy (deterministic)&lt;br&gt;top_p / top_k = narrow token candidates&lt;br&gt;Structured output = JSON schema enforcement&lt;br&gt;Get Code = export prompt → SDK snippet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#1a237e;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="578" width="310" height="115" as="geometry" />
        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- AI Studio = API key; Vertex AI = ADC / GCP project&lt;br&gt;- temperature=0 is greedy decoding&lt;br&gt;- Gemini 3: keep temperature at 1.0 (default)&lt;br&gt;- top_p and top_k both narrow candidates — pick one&lt;br&gt;- System instructions persist across all conversation turns&lt;br&gt;- Structured output: response_mime_type + response_schema&lt;br&gt;- Code Execution: sandboxed Python only, no network&lt;br&gt;- BLOCK_LOW_AND_ABOVE = strictest safety setting&lt;br&gt;- Use google-genai SDK (NOT google-generativeai — deprecated)&lt;br&gt;- thinking_level (Gemini 3) replaces thinking_budget (2.5)&lt;br&gt;- Don't mix thinking_level and thinking_budget in one request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1540" width="360" height="240" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
