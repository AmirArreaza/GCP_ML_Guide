        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- Same model_type as binary — BQML auto-detects&lt;br&gt;- roc_auc NOT in ML.EVALUATE for multiclass&lt;br&gt;- Metrics are weighted averages across classes&lt;br&gt;- Confusion matrix is NxN — use to spot confused pairs&lt;br&gt;- auto_class_weights works for N classes&lt;br&gt;- Probs array has one entry per class (use UNNEST)&lt;br&gt;- Softmax used internally (not sigmoid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="1090" width="300" height="145" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
