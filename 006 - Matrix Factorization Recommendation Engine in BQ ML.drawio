        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- ML.RECOMMEND generates top-N items (not ML.PREDICT)&lt;br&gt;- ML.PREDICT scores specific user-item pairs&lt;br&gt;- IMPLICIT needs no rating_col — uses interaction counts&lt;br&gt;- wals_alpha only applies to IMPLICIT feedback&lt;br&gt;- Ranking metrics (MAP/NDCG) computed manually&lt;br&gt;- Cold start cannot be solved by MF alone&lt;br&gt;- ML.WEIGHTS returns embedding vectors for export&lt;br&gt;- ALS = EXPLICIT / WALS = IMPLICIT algorithm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="770" y="1105" width="300" height="155" as="geometry" />
        </mxCell>

