        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- Formerly called Matching Engine&lt;br&gt;- Tree-AH = production ANN; brute force = eval only&lt;br&gt;- dimensions must match embedding model exactly&lt;br&gt;- DOT_PRODUCT = most common for normalised embeddings&lt;br&gt;- STREAM_UPDATE = realtime; BATCH_UPDATE = bulk&lt;br&gt;- Private VPC endpoint = lowest latency (needs peering)&lt;br&gt;- Brute force NEVER in production — ground truth only&lt;br&gt;- Recall = ANN_correct / num_neighbors&lt;br&gt;- HybridQuery: rrf_ranking_alpha 0=keyword, 1=semantic&lt;br&gt;- V2.0 = Collections + Data Objects (GA 2026)&lt;br&gt;- Index creation takes 10min–1hr for large datasets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1515" width="340" height="215" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
