<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="Claude" version="21.0.0" type="device">
  <diagram name="BigQuery ML - Anomaly Detection Autoencoders" id="bqml-autoencoder">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2100" pageHeight="1450" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== CENTRAL NODE ===== -->
        <mxCell id="center" value="&lt;b&gt;Anomaly Detection&lt;/b&gt;&lt;br&gt;Autoencoders — BigQuery ML&lt;br&gt;&lt;i&gt;model_type = AUTOENCODER&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#880e4f;fontColor=#ffffff;strokeColor=#560027;fontSize=14;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="555" width="275" height="110" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 1: HOW IT WORKS (top-centre) ===== -->
        <mxCell id="b1" value="&lt;b&gt;How It Works&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565c0;fontColor=#ffffff;strokeColor=#0d47a1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="295" width="275" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565c0;strokeWidth=2;" edge="1" source="center" target="b1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-1" value="Encoder compresses input&lt;br&gt;&lt;i&gt;to low-dim latent space&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="205" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;" edge="1" source="b1" target="b1-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-2" value="Decoder reconstructs input&lt;br&gt;&lt;i&gt;from compressed representation&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="140" width="205" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;" edge="1" source="b1" target="b1-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-3" value="Normal: low reconstruction error&lt;br&gt;Anomaly: high reconstruction error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#1565c0;strokeWidth=2;" edge="1" source="b1" target="b1-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b1-4" value="Train on NORMAL data ONLY&lt;br&gt;&lt;i&gt;including anomalies breaks detection&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="210" width="215" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b1-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c62828;strokeWidth=2;" edge="1" source="b1" target="b1-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 2: WORKFLOW (left) ===== -->
        <mxCell id="b2" value="&lt;b&gt;Workflow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;fontColor=#ffffff;strokeColor=#1b5e20;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="215" y="420" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="center" target="b2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-1" value="1. CREATE MODEL&lt;br&gt;&lt;i&gt;AUTOENCODER on normal data&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="230" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;" edge="1" source="b2" target="b2-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-2" value="2. ML.EVALUATE&lt;br&gt;&lt;i&gt;reconstruction loss metrics&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="295" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;" edge="1" source="b2" target="b2-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-3" value="3. ML.DETECT_ANOMALIES&lt;br&gt;&lt;i&gt;primary anomaly scoring function&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="360" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;strokeWidth=2;" edge="1" source="b2" target="b2-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b2-4" value="4. ML.PREDICT&lt;br&gt;&lt;i&gt;returns RECONSTRUCTED values&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="425" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b2-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2e7d32;" edge="1" source="b2" target="b2-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 3: KEY OPTIONS (bottom-left) ===== -->
        <mxCell id="b3" value="&lt;b&gt;Key OPTIONS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695c;fontColor=#ffffff;strokeColor=#004d40;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="215" y="700" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00695c;strokeWidth=2;" edge="1" source="center" target="b3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3-1" value="hidden_units = [64, 32, 16, 32, 64]&lt;br&gt;&lt;i&gt;symmetric encoder-bottleneck-decoder&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="580" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b3-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00695c;" edge="1" source="b3" target="b3-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3-2" value="activation_fn = 'RELU'&lt;br&gt;&lt;i&gt;RELU / SIGMOID / TANH / ELU&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="647" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b3-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00695c;" edge="1" source="b3" target="b3-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3-3" value="dropout + l2_reg&lt;br&gt;&lt;i&gt;prevent perfect reconstruction&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="714" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b3-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00695c;" edge="1" source="b3" target="b3-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3-4" value="optimizer = 'ADAM'&lt;br&gt;&lt;i&gt;ADAM / ADAGRAD / RMSPROP / SGD&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="781" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b3-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00695c;" edge="1" source="b3" target="b3-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3-5" value="max_iterations (epochs)&lt;br&gt;&lt;i&gt;early_stop = TRUE recommended&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="848" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b3-5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00695c;" edge="1" source="b3" target="b3-5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 4: ML.DETECT_ANOMALIES OUTPUT (top-right) ===== -->
        <mxCell id="b4" value="&lt;b&gt;ML.DETECT_ANOMALIES Output&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bf360c;fontColor=#ffffff;strokeColor=#870000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1390" y="250" width="225" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#bf360c;strokeWidth=2;" edge="1" source="center" target="b4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b4-1" value="is_anomaly (BOOL)&lt;br&gt;&lt;i&gt;TRUE = flagged as anomaly&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="105" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b4-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#bf360c;" edge="1" source="b4" target="b4-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b4-2" value="mean_absolute_error&lt;br&gt;&lt;i&gt;per-row reconstruction error&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="173" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b4-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#bf360c;" edge="1" source="b4" target="b4-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b4-3" value="reconstruction_loss&lt;br&gt;&lt;i&gt;total loss for the row&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="241" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b4-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#bf360c;" edge="1" source="b4" target="b4-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b4-4" value="stddev_reconstruction_error&lt;br&gt;&lt;i&gt;std deviation across features&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="309" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b4-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#bf360c;" edge="1" source="b4" target="b4-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 5: CONTAMINATION (bottom-right) ===== -->
        <mxCell id="b5" value="&lt;b&gt;contamination Parameter&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a1b9a;fontColor=#ffffff;strokeColor=#4a148c;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1390" y="690" width="225" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6a1b9a;strokeWidth=2;" edge="1" source="center" target="b5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b5-1" value="Expected fraction of anomalies&lt;br&gt;&lt;i&gt;sets reconstruction error threshold&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="580" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b5-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6a1b9a;" edge="1" source="b5" target="b5-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b5-2" value="Low (0.01) = fewer flags&lt;br&gt;&lt;i&gt;higher precision, lower recall&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="648" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b5-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6a1b9a;" edge="1" source="b5" target="b5-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b5-3" value="High (0.10) = more flags&lt;br&gt;&lt;i&gt;higher recall, lower precision&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="716" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b5-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6a1b9a;" edge="1" source="b5" target="b5-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b5-4" value="Threshold = (1 - contamination) quantile&lt;br&gt;&lt;i&gt;of training reconstruction errors&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="784" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b5-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6a1b9a;" edge="1" source="b5" target="b5-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 6: ARCHITECTURE (middle-right) ===== -->
        <mxCell id="b6" value="&lt;b&gt;Network Architecture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f57f17;fontColor=#ffffff;strokeColor=#e65100;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1390" y="470" width="225" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f57f17;strokeWidth=2;" edge="1" source="center" target="b6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b6-1" value="Input → Encoder layers → Bottleneck&lt;br&gt;&lt;i&gt;compression to latent space&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="395" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b6-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f57f17;" edge="1" source="b6" target="b6-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b6-2" value="Bottleneck → Decoder → Reconstruction&lt;br&gt;&lt;i&gt;symmetric mirror of encoder&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="463" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b6-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f57f17;" edge="1" source="b6" target="b6-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b6-3" value="Smaller bottleneck = better detection&lt;br&gt;&lt;i&gt;forces meaningful compression&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1640" y="531" width="215" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b6-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f57f17;" edge="1" source="b6" target="b6-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== BRANCH 7: PREPROCESSING (bottom-centre) ===== -->
        <mxCell id="b7" value="&lt;b&gt;Preprocessing&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;fontColor=#ffffff;strokeColor=#1c313a;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="910" width="275" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#37474f;strokeWidth=2;" edge="1" source="center" target="b7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-1" value="Normalise features (z-score)&lt;br&gt;&lt;i&gt;autoencoders are scale-sensitive&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="1030" width="205" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-2" value="Encode categoricals (one-hot)&lt;br&gt;&lt;i&gt;works best with numeric input&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="632" y="1030" width="205" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-3" value="Use TRANSFORM clause&lt;br&gt;&lt;i&gt;ML.STANDARD_SCALER inline&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="854" y="1030" width="205" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-4" value="Handle NULLs explicitly&lt;br&gt;&lt;i&gt;anomaly tasks need clean data&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#37474f;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1076" y="1030" width="205" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#37474f;" edge="1" source="b7" target="b7-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- Train on NORMAL data only&lt;br&gt;- ML.DETECT_ANOMALIES = primary inference (not ML.PREDICT)&lt;br&gt;- ML.PREDICT returns RECONSTRUCTED values&lt;br&gt;- No roc_auc or F1 — unsupervised model&lt;br&gt;- contamination controls threshold (higher = more flags)&lt;br&gt;- hidden_units must be symmetric for encoder-decoder&lt;br&gt;- Normalise features — autoencoders are scale-sensitive&lt;br&gt;- dropout + l2_reg prevent trivial perfect reconstruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="770" y="1115" width="310" height="155" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
