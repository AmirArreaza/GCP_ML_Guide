        <mxCell id="e-b7-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f57f17;" edge="1" source="b7" target="b7-3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b7-4" value="RETRIEVAL_DOCUMENT vs RETRIEVAL_QUERY&lt;br&gt;&lt;i&gt;use correct task type for better retrieval&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1305" y="1290" width="225" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-b7-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f57f17;" edge="1" source="b7" target="b7-4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== KEY CONCEPTS BOX ===== -->
        <mxCell id="concepts" value="&lt;b&gt;Core Concepts&lt;/b&gt;&lt;br&gt;Corpus = managed index (collection of chunks)&lt;br&gt;Chunk = unit of retrieval&lt;br&gt;Embedding = semantic vector of a chunk&lt;br&gt;Grounding = constraining LLM with facts&lt;br&gt;top_k = chunks retrieved per query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#004d40;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="545" width="310" height="105" as="geometry" />
        </mxCell>

        <!-- ===== EXAM TIPS BOX ===== -->
        <mxCell id="tips" value="&lt;b&gt;Exam Tips&lt;/b&gt;&lt;br&gt;- Default vector DB = managed Spanner (zero-ops)&lt;br&gt;- Recommended embedding = text-embedding-005&lt;br&gt;- Start with chunk_size=512, chunk_overlap=100&lt;br&gt;- retrieval_query() = chunks only (no LLM)&lt;br&gt;- Tool.from_retrieval() + generate_content() = E2E RAG&lt;br&gt;- ADK: VertexAiRagRetrieval cannot combine with other tools&lt;br&gt;- Hybrid alpha: 0=keyword, 1=semantic (default)&lt;br&gt;- Reranking: retrieve large top_k then re-score&lt;br&gt;- Multi-corpus = security isolation per domain&lt;br&gt;- Check Grounding API validates factual support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1420" width="340" height="195" as="geometry" />
        </mxCell>

      </root>
